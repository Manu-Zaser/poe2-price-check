{
  "name": "poe2-pricecheck",
  "version": "0.8.0",
  "description": "Clipboard-Preischeck-Overlay für Path of Exile 2 (nur lesend, ein Tastendruck = eine Aktion)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Manu-Zaser/poe2-price-check.git"
  },
  "homepage": "https://github.com/Manu-Zaser/poe2-price-check",
  "private": true,
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "node build.mjs && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "@poe2/core": "file:../core",
    "@types/node": "^26.6.6",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^3.3.8"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "koffi@3.3.8": true,
    "electron-winstaller": false,
    "electron": true
  },
  "productName": "PoE2 Price Check",
  "author": "Manu-Zaser",
  "build": {
    "appId": "local.poe2.pricecheck",
    "productName": "PoE2 Price Check",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "PoE2-Price-Check-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PoE2-Price-Check-Setup-${version}.${ext}",
      "shortcutName": "PoE2 Price Check",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Manu-Zaser",
        "repo": "poe2-price-check",
        "releaseType": "release"
      }
    ]
  }
}
